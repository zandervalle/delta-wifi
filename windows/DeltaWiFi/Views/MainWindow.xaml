<Window x:Class="DeltaWiFi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeltaWiFi.Views"
        Title="DELTA Wi-Fi Analyzer" Width="1320" Height="860" MinWidth="960" MinHeight="640"
        Icon="/Assets/app.ico" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNew" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpen" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSave" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="OnSaveAs" />
        <CommandBinding Command="ApplicationCommands.Undo" Executed="OnUndo" CanExecute="CanUndo" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="OnRedo" CanExecute="CanRedo" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Gesture="Ctrl+Shift+S" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neu" Command="ApplicationCommands.New" />
                <MenuItem Header="Ö_ffnen …" Command="ApplicationCommands.Open" />
                <Separator />
                <MenuItem Header="_Speichern" Command="ApplicationCommands.Save" />
                <MenuItem Header="Speichern _unter …" Command="ApplicationCommands.SaveAs" InputGestureText="Strg+Umschalt+S" />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="_Rückgängig" Command="ApplicationCommands.Undo" />
                <MenuItem Header="_Wiederholen" Command="ApplicationCommands.Redo" />
            </MenuItem>
            <MenuItem Header="_Projekt" x:Name="ProjectMenu">
                <MenuItem Header="_Etagen, Phasen und Anschluss …" x:Name="StructureItem" Click="OnEditStructure" />
                <MenuItem Header="Bereiche und _Messpunkte einrichten …" x:Name="SetupItem" Click="OnSetup" />
                <Separator />
                <MenuItem Header="_Grundriss laden …" x:Name="LoadPlanItem" Click="OnLoadPlan" />
                <MenuItem Header="Grundriss en_tfernen" x:Name="RemovePlanItem" Click="OnRemovePlan" />
            </MenuItem>
        </Menu>

        <!-- Werkzeugleiste: Etage, Darstellung, Messpanel -->
        <Border DockPanel.Dock="Top" Padding="12,6">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Etage" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.65" />
                <ComboBox x:Name="FloorPicker" MinWidth="170" SelectionChanged="OnFloorPicked" AutomationProperties.Name="Etage"
                          ToolTip="Angezeigte Etage bzw. Bereich" />
                <ToggleButton x:Name="MeasureToggle" DockPanel.Dock="Right" Content="Messen" Padding="14,5" Margin="12,0,0,0"
                              Checked="OnToggleMeasure" Unchecked="OnToggleMeasure" ToolTip="Geführte Messung an den festen Punkten und Lauf-Modus" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="MapButton" Content="Karte" GroupName="Display" Style="{DynamicResource {x:Type ToggleButton}}"
                                 Padding="14,5" Checked="OnDisplayPicked" ToolTip="Karte mit Heatmap" />
                    <RadioButton x:Name="AnalysisButton" Content="Auswertung" GroupName="Display" Style="{DynamicResource {x:Type ToggleButton}}"
                                 Padding="14,5" Margin="4,0,0,0" Checked="OnDisplayPicked" ToolTip="Übersicht, Tabelle und Details" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="#50808080" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200" MaxWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Liste aller Messpunkte, nach Etage gruppiert -->
            <DockPanel x:Name="Sidebar" Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Content="＋  Punkt hinzufügen" Margin="8" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="OnAddPoint" />
                <Border DockPanel.Dock="Bottom" Height="1" Background="#50808080" />
                <ListBox x:Name="PointList" BorderThickness="0" Background="Transparent" SelectionChanged="OnPointPicked"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#18808080" />

            <DockPanel x:Name="Center" Grid.Column="2">
                <!-- Ansicht, Phase(n), Messgröße und Legende -->
                <!-- Passt nicht alles in eine Zeile, rücken Messgröße und Legende in die nächste. -->
                <WrapPanel DockPanel.Dock="Top" Margin="12,8,12,2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                        <StackPanel x:Name="ViewButtons" Orientation="Horizontal" Margin="0,0,8,0">
                            <RadioButton x:Name="PhaseViewButton" Content="Phase" GroupName="View" Padding="10,4"
                                         Style="{DynamicResource {x:Type ToggleButton}}" Checked="OnViewPicked" />
                            <RadioButton x:Name="ComparisonViewButton" Content="Vergleich" GroupName="View" Padding="10,4" Margin="4,0,0,0"
                                         Style="{DynamicResource {x:Type ToggleButton}}" Checked="OnViewPicked" />
                        </StackPanel>
                        <TextBlock x:Name="ComparisonLabel" Text="Vergleich" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.65" />
                        <ComboBox x:Name="PhasePicker" MinWidth="130" SelectionChanged="OnPhasePicked" ToolTip="Phase"
                                  AutomationProperties.Name="Phase" />
                        <ComboBox x:Name="CompareFromPicker" MinWidth="130" SelectionChanged="OnComparePicked" ToolTip="Vergleich von"
                                  AutomationProperties.Name="Vergleich von" />
                        <TextBlock x:Name="CompareArrow" Text="→" VerticalAlignment="Center" Margin="8,0" Opacity="0.65" />
                        <ComboBox x:Name="CompareToPicker" MinWidth="130" SelectionChanged="OnComparePicked" ToolTip="Vergleich nach"
                                  AutomationProperties.Name="Vergleich nach" />
                    </StackPanel>
                    <ComboBox x:Name="MetricPicker" MinWidth="200" Margin="0,0,16,6" SelectionChanged="OnMetricPicked" ToolTip="Messgröße"
                              AutomationProperties.Name="Messgröße" />
                    <ContentControl x:Name="LegendHost" VerticalAlignment="Center" Margin="0,0,0,6" Focusable="False" />
                </WrapPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="#50808080" />

                <!-- Fußzeile der Karte -->
                <DockPanel x:Name="Footer" DockPanel.Dock="Bottom" Margin="12,6">
                    <TextBlock x:Name="PlacedText" DockPanel.Dock="Right" Opacity="0.65" Margin="12,0,0,0" />
                    <TextBlock x:Name="HintText" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Border x:Name="FooterDivider" DockPanel.Dock="Bottom" Height="1" Background="#50808080" />

                <Grid>
                    <views:PlanView x:Name="PlanCanvas" />
                    <ContentControl x:Name="AnalysisHost" Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <!-- Messpanel: feste Punkte oder Lauf -->
            <Border x:Name="SidePanel" Grid.Column="3" Width="350" BorderBrush="#50808080" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <RadioButton x:Name="PointsTab" Content="Feste Punkte" GroupName="Panel" Padding="14,5"
                                     Style="{DynamicResource {x:Type ToggleButton}}" Checked="OnPanelTabPicked" />
                        <RadioButton x:Name="WalkTab" Content="Lauf" GroupName="Panel" Padding="14,5" Margin="4,0,0,0"
                                     Style="{DynamicResource {x:Type ToggleButton}}" Checked="OnPanelTabPicked" />
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="#50808080" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="PanelHost" Margin="10" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Ohne Bereiche gibt es nichts zu zeigen: Die Einrichtung verdeckt Karte und Auswertung. -->
            <Border x:Name="EmptyOverlay" Grid.ColumnSpan="4" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Projekt einrichten" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Lege zuerst die Etagen oder Bereiche und ihre Messpunkte an." Opacity="0.65" Margin="0,8,0,16"
                               HorizontalAlignment="Center" />
                    <Button Content="Einrichten …" Padding="18,6" HorizontalAlignment="Center" Click="OnSetup" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
